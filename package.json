{
  "name": "magpie-provider-bundle",
  "version": "0.6.8",
  "private": true,
  "description": "One Magpie plugin for all third-party providers, with a single overview page, per-provider switches and unchanged upstream drivers",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs"
  },
  "files": [
    "index.mjs",
    "providers.config.mjs",
    "runtime",
    "page",
    "vendor",
    "NOTICE.md",
    "README.md",
    "README.zh-CN.md",
    "vendor.lock.json"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "lock": "node scripts/lock.mjs",
    "spark:models": "node scripts/spark-models.mjs",
    "verify": "node scripts/verify.mjs",
    "regression": "node scripts/regression.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node scripts/generate.mjs && node scripts/lock.mjs && node scripts/verify.mjs && node scripts/regression.mjs && node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "magpie": {
    "maxConcurrency": 4,
    "icon": "data:image/png;base64,",
    "page": {
      "title": "供应商总览",
      "file": "page/index.html",
      "titles": {
        "zh": "供应商总览"
      },
      "icon": "page/icon.png"
    },
    "panels": [
      {
        "slot": "provider",
        "file": "page/provider-panel.html",
        "title": "Provider status",
        "titles": {
          "zh": "供应商状态"
        }
      }
    ]
  }
}
